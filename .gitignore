# ==============================================================================
# QuickBite Food Delivery System - Root .gitignore
# Excludes build artifacts, package dependencies, environment secrets, and IDE files
# ==============================================================================

# --- Node & Frontend Dependencies ---
node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/
.npm/
.eslintcache
.stylelintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Java & Maven Build Artifacts ---
target/
**/target/
*.class
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*

# --- Environment Variables & Secrets ---
.env
.env.*
*.env
!.env.example
!.env.*.example
application-local.properties
**/application-local.properties
*local.properties
**/secrets/
*.pem
*.key
*.pkcs12
*.p12
*.pfx

# --- IDE & Editor Specific Files ---
.idea/
*.iml
*.iws
*.ipr
out/
**/out/
.vscode/
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/
bin/

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- Logs & Temporary Files ---
*.log
logs/
**/logs/
tmp/
temp/
*.tmp
*.bak
*.swp
*~

